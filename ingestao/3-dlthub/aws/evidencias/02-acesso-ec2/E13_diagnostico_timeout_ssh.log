PS D:\GitHub\LAB_GrupoA_EcossistemadeBigData\ingestao\1-infraestrutura\aws\terraform> $TEM_CIDR_LOCAL = $false
$TEM_PREFIX_LIST = $false

foreach ($REGRA in $REGRAS_SSH) {

    foreach ($IPV4 in @($REGRA.IpRanges)) {
        if ($IPV4.CidrIp -eq "$MEU_IP/32") {
            $TEM_CIDR_LOCAL = $true
        }
    }

    if (@($REGRA.PrefixListIds).Count -gt 0) {
        $TEM_PREFIX_LIST = $true
    }
}

Write-Host ""
Write-Host "===================================================="
Write-Host "RESUMO DO DIAGNOSTICO SSH"
Write-Host "===================================================="

Write-Host "EC2Estado=$ESTADO"
Write-Host "EC2PublicIp=$PUBLIC_IP"
Write-Host "SecurityGroup=$SG_ID"
Write-Host "MeuIPPublico=$MEU_IP"
Write-Host "RegraParaMeuIP=$TEM_CIDR_LOCAL"
Write-Host "RegraComPrefixList=$TEM_PREFIX_LIST"
Write-Host "TcpTestSucceeded=$($TESTE_SSH.TcpTestSucceeded)"

if (
    $ESTADO -eq "running" -and
    $TEM_PREFIX_LIST -and
    -not $TEM_CIDR_LOCAL -and
    -not $TESTE_SSH.TcpTestSucceeded
) {
    Write-Host "Diagnostico=SSH_LOCAL_NAO_AUTORIZADO"
    Write-Host "Alternativa=EC2_INSTANCE_CONNECT"
}
elseif ($TESTE_SSH.TcpTestSucceeded) {
    Write-Host "Diagnostico=PORTA_22_ACESSIVEL"
    Write-Host "Alternativa=SSH_POWERSHELL"
}
else {
    Write-Host "Diagnostico=REVISAR_REDE"
    Write-Host "Alternativa=EC2_INSTANCE_CONNECT"
}

Stop-Transcript

