PS D:\GitHub\LAB_GrupoA_EcossistemadeBigData\ingestao\1-infraestrutura\aws\terraform> $SG_JSON = aws ec2 describe-security-groups `
    --group-ids $SG_ID `
    --region $REGION `
    --output json

$SG_DESCRIBE_EXIT = $LASTEXITCODE

$SG = (
    $SG_JSON |
    ConvertFrom-Json
).SecurityGroups[0]

$REGRAS_SSH = @(
    $SG.IpPermissions |
    Where-Object {
        $_.IpProtocol -eq "tcp" -and
        $_.FromPort -eq 22 -and
        $_.ToPort -eq 22
    }
)

Write-Host ""
Write-Host "===================================================="
Write-Host "REGRAS SSH DO SECURITY GROUP"
Write-Host "===================================================="

if ($REGRAS_SSH.Count -eq 0) {
    Write-Host "Nenhuma regra de entrada para a porta 22."
}
else {
    foreach ($REGRA in $REGRAS_SSH) {

        foreach ($IPV4 in @($REGRA.IpRanges)) {
            Write-Host "SSHIPv4=$($IPV4.CidrIp)"
            Write-Host "DescricaoIPv4=$($IPV4.Description)"
        }

        foreach ($PREFIXO in @($REGRA.PrefixListIds)) {
            Write-Host "SSHPrefixListId=$($PREFIXO.PrefixListId)"
            Write-Host "DescricaoPrefixList=$($PREFIXO.Description)"
        }

        foreach ($GRUPO in @($REGRA.UserIdGroupPairs)) {
            Write-Host "SSHSourceSecurityGroup=$($GRUPO.GroupId)"
        }
    }
}

Write-Host "sg_describe_exit_code=$SG_DESCRIBE_EXIT"

